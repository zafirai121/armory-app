<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 10+: follows the phone's light / dark setting; the page's
         prefers-color-scheme follows this theme -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
    </style>
</resources>
